Project InternetRadio {
  database_type: 'SQLite / Room'
  Note: '''
    # Internet Radio Database Schema
    Local Room database storing stations, recent playback,
    rolling track history, separate per-station starred tracks, and schedules.
  '''
}

Enum schedule_type {
  PLAYBACK [note: 'Alarm station stream playback']
  RECORD [note: 'Stream recording']
}

Table stations {
  stationUuid text [pk, note: 'Unique Station UUID']
  name text [not null, note: 'Station display name']
  url text [not null, note: 'Stream URL']
  urlResolved text [not null, note: 'Resolved playable stream URL']
  favicon text [not null, note: 'Station icon URL']
  tags text [not null, note: 'Comma-separated genres/tags']
  countryCode text [not null, note: '2-letter ISO country code']
  languageCodes text [not null, default: '', note: 'Comma-separated language codes']
  codec text [not null, note: 'Audio codec (e.g. MP3, AAC)']
  bitrate integer [not null, note: 'Bitrate in kbps']
  homepage text [not null, default: '', note: 'Website URL']
  iso3166_2 text [note: 'Subdivision or state code']
  geoLat real [note: 'Latitude']
  geoLong real [note: 'Longitude']
  isCustom integer [not null, default: 0, note: '1 if user custom station']
  isFavorite integer [not null, default: 0, note: '1 if saved in library']
  addedAt integer [note: 'Timestamp when added to library']
  orderIndex integer [not null, default: 0, note: 'Custom reordering position']
  lastPlayedAt integer [note: 'Timestamp when last played']
}

Table recent_stations {
  stationUuid text [pk, note: 'Station UUID']
  name text [not null]
  url text [not null]
  urlResolved text [not null]
  favicon text [not null]
  tags text [not null]
  countryCode text [not null]
  languageCodes text [not null]
  codec text [not null]
  bitrate integer [not null]
  homepage text [not null]
  iso3166_2 text
  geoLat real
  geoLong real
  isCustom integer [not null]
  lastPlayedAt integer [not null, note: 'Timestamp when played']
}

Table track_history {
  id integer [pk, increment, note: 'Primary key']
  stationUuid text [not null, note: 'Station UUID']
  trackTitle text [not null, note: 'Clean track title']
  rawTrackTitle text [not null, default: '', note: 'Raw stream metadata string']
  artist text [note: 'Parsed artist']
  coverArtUrl text [note: 'Artwork URL']
  timestamp integer [not null, note: 'Epoch ms when track started']
  endTimestamp integer [not null, default: 0, note: 'Epoch ms when track ended']
  durationMs integer [not null, default: 0, note: 'Listening duration in ms']
  lyricsLocator text [note: 'Opaque lyrics provider locator pointer, e.g. lrclib:2392']

  indexes {
    (stationUuid, timestamp)
  }
}

Table starred_tracks {
  id integer [pk, increment, note: 'Primary key']
  stationUuid text [not null, note: 'Station UUID']
  trackTitle text [not null, note: 'Unique track title on this station']
  rawTrackTitle text [not null, default: '', note: 'Original stream title']
  artist text [note: 'Parsed artist']
  coverArtUrl text [note: 'Artwork URL']
  starredAt integer [not null, note: 'Epoch ms when starred']
  lyricsLocator text [note: 'Opaque lyrics provider locator pointer, e.g. lrclib:2392']

  indexes {
    (stationUuid, trackTitle) [unique]
    (stationUuid, starredAt)
  }
}

Table schedules {
  id integer [pk, increment]
  stationUuid text [not null]
  stationName text [not null]
  type schedule_type [not null]
  triggerTimeInMillis integer [not null]
  durationMinutes integer [not null]
  isRecurring integer [not null]
  daysOfWeek text [not null]
  timeHour integer [not null]
  timeMinute integer [not null]
  isEnabled integer [not null]
  volumeLevel real [not null, default: 1.0]
  keepPlayback integer [not null, default: 0]
  playOnRecording integer [not null, default: 1]
  scheduleName text [not null, default: '']
}

Ref: track_history.stationUuid > stations.stationUuid
Ref: starred_tracks.stationUuid > stations.stationUuid
Ref: recent_stations.stationUuid > stations.stationUuid
Ref: schedules.stationUuid > stations.stationUuid
